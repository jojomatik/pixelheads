    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
