{
  "compilerOptions": {
    "module": "node16",
    "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "isolatedModules": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["**/*.test.ts"]
}
