{
  "compilerOptions": {
    "module": "node16",
    "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "rootDir": "./src",
    "sourceMap": true,
    "outDir": "dist",
    "paths": {
      "*": [
        "./node_modules/*",
        "./src/types/*"
      ]
    },
    "declaration": true,
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["**/*.test.ts"]
}
