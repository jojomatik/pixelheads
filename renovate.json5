{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "config:js-lib",
    "mergeConfidence:all-badges",
    ":semanticCommitTypeAll(build)",
  ],
  "labels": ["type:build"],
  "separateMultipleMajor": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies", "dev-dependencies", "dev"],
      // Runtime dependencies take precedence across all updates in the branch.
      "semanticCommitScope": "{{#if (includes depTypes 'dependencies')}}deps{{else}}deps-dev{{/if}}",
      "addLabels": ["scope:deps-dev"],
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitScope": "deps-dev",
      "addLabels": ["scope:deps-dev"],
    },
    {
      "matchDepTypes": ["dependencies"],
      "addLabels": ["scope:deps"],
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeStrategy": "rebase",
    },
    {
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeStrategy": "rebase",
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
    },
    {
      // Types must match the minimum supported Node version ("engines" in package.json).
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23",
    },
    {
      // CI tests supported LTS releases only; the build matrix is maintained manually.
      "matchDepNames": ["node"],
      "matchManagers": ["github-actions"],
      "allowedVersions": "/^(22|24|26)(\\.|$)/",
    },
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeStrategy": "rebase",
  },
}
